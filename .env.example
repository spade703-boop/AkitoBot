DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080
ONEBOT_WS_URLS=["ws://127.0.0.1:3000"]

COMMAND_START=[""]
NICKNAME=["松饼小彰"]

HTTP_TIMEOUT=120
API_TIMEOUT=120

# API Keys (replace with your own)
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 剧情分析输出上限（长剧情建议 3200，程序限制在 256-8192）
# DEEPSEEK_MAX_TOKENS=3200
TAVILY_API_KEY=tvly-your-tavily-key
ZHIPU_API_KEY=your-zhipu-key
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# Bot 管理
SUPERUSER_QQ=your_qq
TOYA_QQ_ID=your_toya_qq
GLOBAL_PROFILE_SOURCE_GROUP=691188576

# 群号白名单（逗号分隔）
ALLOWED_CHAT_GROUPS=
ALLOWED_CP_GROUPS=
ALLOWED_MEMORY_GROUPS=
TARGET_GROUPS=
# 每日群聊词云目标群（独立开关，逗号分隔）
WORDCLOUD_GROUPS=
# 历史回填来源（默认使用 data/impression_history.db，可指向线上复制的切片）
WORDCLOUD_HISTORY_DB=

# 图库权限（JSON 格式，key 为群号）
GROUP_IMAGE_PERMISSIONS={}

# 对话 M0 trace（可选；只写入请求元数据，不写入用户原文）
# AKITO_CONVERSATION_TRACE_PATH=data/conversation_ai/traces/conversation_traces.jsonl

# M1/M2 灰度（默认保持旧行为：M1 仅 shadow，M2 关闭）
AKITO_M1_CONTEXT_MODE=shadow
AKITO_M2_MEMORY_MODE=off
# EventMemory 检索策略：lexical 安全词法；hybrid 需要生产环境构建事件向量索引
AKITO_EVENT_MEMORY_RETRIEVAL=lexical
# 指定群组实验臂：{"群号":"control|m1|m2|combined"}
AKITO_EXPERIMENT_GROUPS={}
